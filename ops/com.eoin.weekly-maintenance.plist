<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eoin.weekly-maintenance</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ai-code/bin/weekly-maintenance.sh</string>
  </array>
  <!-- StartCalendarInterval never fired on this headless login (runs=0 across two
       Mondays). StartInterval is not tied to a GUI session and launchd catches up
       a missed run, so it survives reboots and long uptimes. 604800s = 7 days. -->
  <key>StartInterval</key>
  <integer>604800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/ai-code/claude-tools/maintenance.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/ai-code/claude-tools/maintenance.err</string>
</dict>
</plist>
